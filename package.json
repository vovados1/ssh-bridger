{
  "name": "ssh-bridger",
  "version": "0.1.0",
  "description": "Dual-pane style file manager for your machine and any SSH/SFTP host",
  "private": true,
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "pnpm build && electron-builder --linux",
    "package:dir": "pnpm build && electron-builder --linux --dir"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/react-virtual": "^3.14.15",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "ssh-config": "^5.3.0",
    "ssh2": "^1.17.0",
    "zod": "^4.6.6"
  },
  "author": "SSH Bridger Maintainers <maintainers@ssh-bridger.invalid>",
  "homepage": "https://github.com/vovados1/ssh-bridger",
  "repository": {
    "type": "git",
    "url": "https://github.com/vovados1/ssh-bridger.git"
  }
}
